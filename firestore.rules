rules_version = '2';

// ══════════════════════════════════════════════════════════════════════════
//  Mindkraft — Firestore security rules
//
//  This file is the canonical copy of the rules. It is NOT wired into
//  firebase.json, so `firebase deploy` will not push it; the rules are
//  managed in the Firebase console. Keep the two in sync by hand.
//
//  There are three cross-account surfaces: the versus-challenge block at
//  the bottom, the gift pair (a sender writing into a receiver's subtree and
//  the receiver stamping four fields back on the sender's mirror), and
//  leaderboardBoards, whose read rule is itself the mutuality test. Each is
//  scoped to the accounts named inside the document, and no rule anywhere
//  grants one party read access to anything else the other owns.
// ══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Subcollections are NOT covered by the /users/{uid} rule above —
    // they must be matched explicitly, which is why this block exists.
    match /users/{uid}/reminders/{reminderId} {
      allow read, update, delete: if request.auth != null
                                  && request.auth.uid == uid;

      // Activity reminders are created by the createActivityReminder
      // Cloud Function (which bypasses rules) so the 5-per-user cap is
      // enforced server-side. Only the general singleton is client-created.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && reminderId == 'general'
                    && request.resource.data.type == 'general'
                    && request.resource.data.localTime is string
                    && request.resource.data.localTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
                    && request.resource.data.active is bool;
    }

    // Append-only Grit ledger. Entries are never mutated or deleted — a
    // balance movement that happened stays in the record.
    match /users/{uid}/gritLedger/{entryId} {
      allow read, create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════
    //  GIFTS  —  users/{receiverUid}/gifts and users/{senderUid}/giftsSent
    //
    //  The one place in the app where a client writes into another user's
    //  subtree, in both directions:
    //
    //    the SENDER creates the gift in the RECEIVER's `gifts`
    //    the RECEIVER stamps four fields on the SENDER's `giftsSent` mirror
    //
    //  Both are scoped as tightly as the flow allows. `type` is validated
    //  against the enum here, not just in the client: a client that can write
    //  an arbitrary type can invent gift kinds. A user can never create a gift
    //  in their own receiving subcollection, so nobody can mint themselves a
    //  shield or a double-XP.
    //
    //  Same 1000-expression budget as the challenges block below: the denied
    //  write is the expensive case, so these use diff().affectedKeys() and
    //  keys().hasOnly() rather than field-by-field comparison.
    // ══════════════════════════════════════════════════════════════════

    match /users/{receiverUid}/gifts/{giftId} {
      function next()    { return request.resource.data; }
      function prev()    { return resource.data; }
      function changed() { return next().diff(prev()).affectedKeys(); }

      // The receiver's own inbox. They may read it and consume from it; they
      // may never create in it.
      allow read: if request.auth != null && request.auth.uid == receiverUid;

      allow create: if request.auth != null
                    && request.auth.uid != receiverUid
                    && next().senderUid == request.auth.uid
                    && next().receiverUid == receiverUid
                    && next().id == giftId
                    && next().type in ['shield', 'xp_boost']
                    && next().status == 'pending'
                    && next().sentAt is string
                    && next().senderName is string
                    && next().receiverName is string
                    && next().consumedAt == null
                    && next().consumedActivityId == null
                    && next().consumedActivityTitle == null
                    && next().baseXP == null
                    && next().awardedXP == null
                    && next().thanked == false
                    && next().thankedAt == null
                    && next().keys().hasOnly(['id', 'type', 'senderUid', 'senderName',
                                              'receiverUid', 'receiverName', 'sentAt', 'status',
                                              'consumedAt', 'consumedActivityId',
                                              'consumedActivityTitle', 'baseXP', 'awardedXP',
                                              'thanked', 'thankedAt'])
                    // You may only gift someone on your own friends list.
                    // get() reads the SENDER's own document and grants nobody
                    // any read access; .get('friends', []) so an account
                    // predating the field is denied rather than erroring.
                    && receiverUid in
                       get(/databases/$(database)/documents/users/$(request.auth.uid))
                         .data.get('friends', []);

      // pending → consumed, plus the thanks flag. What the gift IS never
      // moves: not its type, not who sent it, not when.
      allow update: if request.auth != null
                    && request.auth.uid == receiverUid
                    && next().status == 'consumed'
                    && next().thanked is bool
                    && changed().hasOnly(['status', 'consumedAt', 'consumedActivityId',
                                          'consumedActivityTitle', 'baseXP', 'awardedXP',
                                          'thanked', 'thankedAt', 'mirrorSynced']);

      // A gift that happened stays in the record.
      allow delete: if false;
    }

    match /users/{senderUid}/giftsSent/{giftId} {
      function next()    { return request.resource.data; }
      function prev()    { return resource.data; }
      function changed() { return next().diff(prev()).affectedKeys(); }

      allow read: if request.auth != null && request.auth.uid == senderUid;

      allow create: if request.auth != null
                    && request.auth.uid == senderUid
                    && next().senderUid == senderUid
                    && next().receiverUid != senderUid
                    && next().id == giftId
                    && next().type in ['shield', 'xp_boost']
                    && next().status == 'pending'
                    && next().thanked == false;

      // The unusual permission: the RECEIVER writes into the sender's tree.
      // Scoped to exactly four fields, and only on a document that names them
      // as its receiver — nobody gets broad write access to another user's
      // subtree, and a spoofed receiverUid cannot be written in the first
      // place because create above pins it to the sender's own batch.
      allow update: if request.auth != null
                    && request.auth.uid == prev().receiverUid
                    && next().status == 'consumed'
                    && next().thanked is bool
                    && changed().hasOnly(['status', 'consumedAt', 'thanked', 'thankedAt']);

      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════
    //  LEADERBOARD BOARDS  —  leaderboardBoards/{uid}
    //
    //  Published only by users who have opted into weekly payouts. The read
    //  rule IS the mutuality test (§8.1): you may read someone's board only
    //  if you appear on it, in the live roster or in either frozen one. A
    //  denied read is the answer "not mutual" — no social graph leaks past
    //  that, which is why board membership does not live on publicProfiles,
    //  where every signed-in user can read it.
    // ══════════════════════════════════════════════════════════════════
    match /leaderboardBoards/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid
                      || request.auth.uid in resource.data.get('members', [])
                      || request.auth.uid in resource.data.get('scored', [])
                      || request.auth.uid in resource.data.get('prevScored', []));

      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.data.uid == uid;

      // Opting out withdraws the board entirely.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /publicProfiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /friendRequests/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.fromUID == request.auth.uid;
      allow read, delete: if request.auth != null
                          && resource.data.toUID == request.auth.uid;
    }

    match /groupChallenges/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.creatorUid == request.auth.uid;
      allow update: if request.auth != null
                    && (
                      request.auth.uid == resource.data.creatorUid
                      || request.auth.uid in resource.data.members
                      || request.resource.data.members[request.auth.uid] != null
                    );
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.creatorUid;
    }

    match /groupInviteCodes/{code} {
      allow read, create: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /groupInvitations/{inviteId} {
      allow read: if request.auth != null
                  && (resource.data.inviteeUid == request.auth.uid
                      || resource.data.inviterUid == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.inviterUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.inviteeUid == request.auth.uid;
    }

    // ══════════════════════════════════════════════════════════════════
    //  VERSUS CHALLENGES  —  top-level `challenges`
    //
    //  Two accounts read and write one document. The document is the whole
    //  cross-account surface: counters, the agreed requirement list, each
    //  side's own mapping, and the escrow bookkeeping. Nothing else.
    //
    //  Three things these rules must guarantee, because Grit depends on
    //  them:
    //    1. A document is never deleted — escrowed Grit must never be
    //       strandable by deleting the record of it.
    //    2. The pot is conserved. Every terminal transition zeroes `pot`
    //       and records the same number across `payout`.
    //    3. A participant may write only their own keys — and
    //       `payoutClaimed[me]` only from false to true, which is what
    //       makes the payout claim idempotent.
    //
    //  What these rules deliberately do NOT prevent: a participant
    //  inflating their own `progress` counter with a crafted write. That
    //  is the same trust boundary as the app's completion model generally
    //  — there is no verification that any completion is real, anywhere in
    //  Mindkraft, and Grit has no external value. It is a decision, not an
    //  oversight.
    // ══════════════════════════════════════════════════════════════════
    match /challenges/{challengeId} {

      // Firestore caps a single rule evaluation at 1000 expressions, and a
      // DENIED write is the expensive case: it evaluates every branch before
      // it can conclude. So this block is written for that budget —
      // `diff().affectedKeys()` instead of field-by-field comparison, and a
      // cheap status discriminator in front of every transition so only one
      // heavy branch ever runs. An earlier version of these rules blew the
      // ceiling, which denies the write with a limit error rather than a rule
      // decision — indistinguishable from a real refusal, and it would
      // eventually have bitten a legitimate write.

      function auth()    { return request.auth.uid; }
      function prev()    { return resource.data; }
      function next()    { return request.resource.data; }
      function changed() { return next().diff(prev()).affectedKeys(); }
      function otherThan(u) { return prev().participants[0] == u
                                   ? prev().participants[1] : prev().participants[0]; }

      // Terms both sides agreed to. None of it moves once the document
      // exists; startedAt and endsAt are writable exactly once, on accept,
      // while they are both still null.
      function termsFrozen() {
        return !changed().hasAny(['createdBy', 'opponent', 'participants', 'requirements',
                                  'stake', 'durationDays', 'createdAt', 'expiresAt',
                                  'name', 'bonusXP', 'names', 'mode', 'schemaVersion'])
            && (prev().startedAt == null || !changed().hasAny(['startedAt', 'endsAt']));
      }

      // The rule that keeps one participant out of the other's half of the
      // document. Every per-user map may gain or change exactly one key: the
      // caller's own. This is what makes progress, mapping and the payout
      // claim untouchable from the other side.
      function ownKeysOnly() {
        return next().progress.diff(prev().progress).affectedKeys().hasOnly([auth()])
            && next().mapping.diff(prev().mapping).affectedKeys().hasOnly([auth()])
            && next().totals.diff(prev().totals).affectedKeys().hasOnly([auth()])
            && next().payoutClaimed.diff(prev().payoutClaimed).affectedKeys().hasOnly([auth()])
            && next().seen.diff(prev().seen).affectedKeys().hasOnly([auth()]);
      }

      // Every terminal transition zeroes the pot and records exactly that pot
      // across the two payout slots. Grit is neither created nor destroyed by
      // a resolution.
      function potConserved() {
        return next().pot == 0
            && next().payout[prev().participants[0]] >= 0
            && next().payout[prev().participants[1]] >= 0
            && next().payout[prev().participants[0]]
             + next().payout[prev().participants[1]] == prev().pot;
      }

      // ── Status unchanged ──────────────────────────────────────────
      function markSeen() { return changed().hasOnly(['seen']); }

      function play() {
        return prev().status == 'active'
            && !changed().hasAny(['pot', 'payout', 'winner', 'outcome',
                                  'resolvedAt', 'mapping', 'payoutClaimed']);
      }

      // Claiming your own payout: false → true, and nothing else moves. That
      // flag is what makes the claim idempotent however many times a client
      // retries it.
      function claim() {
        return prev().status != 'pending'
            && prev().status != 'active'
            && !changed().hasAny(['pot', 'payout', 'winner', 'outcome',
                                  'resolvedAt', 'mapping', 'progress', 'totals'])
            && prev().payoutClaimed[auth()] == false
            && next().payoutClaimed[auth()] == true;
      }

      // ── Transitions ───────────────────────────────────────────────
      function accept() {
        return auth() == prev().opponent
            && next().pot == prev().stake * 2
            && next().startedAt is number
            && next().endsAt == next().startedAt + prev().durationDays * 86400000
            && next().winner == null
            && next().outcome == null
            && next().resolvedAt == null
            && !changed().hasAny(['payout', 'payoutClaimed', 'progress', 'totals'])
            // every requirement mapped before the stake is taken
            && next().mapping[auth()].size() == prev().requirements.size();
      }

      // Decline, withdraw and expire refund identically. Only the challenger
      // has paid while a challenge is pending — escrow happens at invite — so
      // the whole pot is owed back to them, and the decliner cannot redirect
      // it to themselves.
      function endPending() {
        return next().winner == null
            && next().resolvedAt is number
            && potConserved()
            && next().payout[prev().createdBy] == prev().pot
            && !changed().hasAny(['mapping', 'progress', 'totals', 'payoutClaimed'])
            && (
                 (next().status == 'declined'
                    && next().outcome == 'declined_refund'
                    && auth() == prev().opponent)
              || (next().status == 'cancelled'
                    && next().outcome == 'cancelled_refund'
                    && auth() == prev().createdBy)
              || (next().status == 'expired'
                    && next().outcome == 'expired_refund'
                    && request.time.toMillis() > prev().expiresAt)
               );
      }

      // Whoever's client gets here first wins the race; the loser's write
      // fails the status discriminator and is a no-op, so two clients
      // resolving at once cannot double-pay.
      function resolveActive() {
        return next().resolvedAt is number
            && !changed().hasAny(['mapping', 'payoutClaimed'])
            && potConserved()
            && (
                 // Level at the deadline — both stakes go home whole.
                 (next().winner == null
                    && next().outcome == 'tie_refund'
                    && next().payout[prev().participants[0]]
                    == next().payout[prev().participants[1]])

                 // Forfeit. You may only ever forfeit YOURSELF: the winner has
                 // to be the other side, so this cannot buy a win.
              || (next().outcome == 'forfeit'
                    && next().winner == otherThan(auth())
                    && next().payout[next().winner] == prev().pot)

                 // Won on the counters. The winner must not be behind.
              || ((next().outcome == 'completed_first' || next().outcome == 'deadline_lead')
                    && next().winner in prev().participants
                    && next().payout[next().winner] == prev().pot
                    && next().totals[next().winner] >= next().totals[otherThan(next().winner)])
               );
      }

      allow read: if request.auth != null
                  && auth() in prev().participants;

      allow create: if request.auth != null
                    && next().createdBy == auth()
                    && next().mode == 'versus'
                    && next().status == 'pending'
                    && next().participants.size() == 2
                    && auth() in next().participants
                    && next().opponent in next().participants
                    && next().opponent != auth()
                    // Stake bounds, per the Grit rate card's reserved table.
                    && next().stake >= 25
                    && next().stake <= 100
                    // The pot is real from the moment the invite exists.
                    && next().pot == next().stake
                    && next().durationDays >= 1
                    && next().durationDays <= 90
                    && next().requirements.size() >= 1
                    && next().requirements.size() <= 5
                    && next().expiresAt is number
                    && next().startedAt == null
                    && next().endsAt == null
                    && next().resolvedAt == null
                    && next().winner == null
                    && next().outcome == null
                    && next().totals[auth()] == 0
                    && next().totals[next().opponent] == 0
                    && next().payout[auth()] == 0
                    && next().payout[next().opponent] == 0
                    && next().payoutClaimed[auth()] == false
                    && next().payoutClaimed[next().opponent] == false
                    && next().progress[auth()].size() == 0
                    && next().progress[next().opponent].size() == 0
                    && next().mapping[next().opponent].size() == 0
                    // You may only wager against someone on your own friends
                    // list. get() reads the challenger's OWN document and
                    // grants nobody any read access; .get('friends', []) so an
                    // account predating the field is denied rather than
                    // erroring.
                    && next().opponent in
                       get(/databases/$(database)/documents/users/$(auth()))
                         .data.get('friends', []);

      // One cheap status discriminator in front of each branch, so a denial
      // never has to evaluate all of them.
      allow update: if request.auth != null
                    && auth() in prev().participants
                    && termsFrozen()
                    && ownKeysOnly()
                    && (
                         (next().status == prev().status
                            && (markSeen() || play() || claim()))
                      || (prev().status == 'pending' && next().status == 'active'
                            && accept())
                      || (prev().status == 'pending' && next().status != 'active'
                            && endPending())
                      || (prev().status == 'active' && next().status == 'resolved'
                            && resolveActive())
                       );

      // Escrowed Grit must never be strandable by deleting the document that
      // records it.
      allow delete: if false;
    }

  }
}
