// ── Reminders subcollection ───────────────────────────────────────────────
//
// ⚠️ PLACEMENT MATTERS MORE THAN THE RULE ITSELF.
//
// This block goes INSIDE `match /databases/{database}/documents { }`, next to
// the other match blocks. One level up — directly inside
// `service cloud.firestore { }` — it publishes without any error but silently
// matches nothing, and every read of the reminders collection is denied.
//
// That failure is worth recognising because it looks like something else
// entirely: notifications keep arriving (the Cloud Function uses the Admin
// SDK and bypasses rules) while the settings list stays stubbornly empty.
//
//   rules_version = '2';
//   service cloud.firestore {
//     match /databases/{database}/documents {
//
//       match /users/{uid} { ... }
//
//       <<< HERE >>>
//
//     }
//   }                        <-- NOT after this brace
//
// Also: a subcollection is NOT covered by its parent's rule. An existing
// `match /users/{uid}` grants nothing under users/{uid}/reminders/... unless
// it uses a `{document=**}` wildcard, so this explicit block is needed either
// way.
//
// Paste it into your existing ruleset. Do not replace the whole ruleset with
// this file — it only covers reminders.

match /users/{uid}/reminders/{reminderId} {

  // Owner-only access. Update covers the active toggle and time edits;
  // delete covers removing a reminder from the settings list.
  allow read, update, delete: if request.auth != null
                              && request.auth.uid == uid;

  // Creation is split (spec §8):
  //
  //  - The general reminder is a singleton with a fixed doc id, so there is
  //    no cap to enforce and the client may create it directly.
  //  - Activity reminders must go through the createActivityReminder callable,
  //    which enforces the 5-per-user cap and validates that the activityId
  //    actually exists in the user's dimension tree. The Admin SDK bypasses
  //    rules, so denying creation here is what forces clients through it.
  allow create: if request.auth != null
                && request.auth.uid == uid
                && reminderId == 'general'
                && request.resource.data.type == 'general'
                && request.resource.data.localTime is string
                && request.resource.data.localTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
                && request.resource.data.active is bool;
}
